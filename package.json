{
  "name": "react-toast-manager",
  "version": "1.0.0",
  "description": "React notification service...",
  "main": "./dist/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build:types": "tsc --noEmitOnError false",
    "build:lib": "npx webpack --mode production",
