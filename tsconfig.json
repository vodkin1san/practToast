
{
  "compilerOptions": {
    "target": "es5",
    "lib": ["dom", "dom.iterable", "esnext", "DOM", "ES2022"],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "strict": true,
    "module": "esnext",
    "jsx": "react-jsx",
    "moduleResolution": "node",
    "types": ["react", "react-dom", "node"],
    "declaration": true,         
    "declarationDir": "./dist/types",   
    "baseUrl": "src",
    "emitDeclarationOnly": true ,
    "rootDir": "./src"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"], 
  "exclude": [
    "node_modules",
    "dist",                  
    "src/stories",           
    "**/*.stories.tsx",      
    "**/*.test.ts",          
    "**/*.test.tsx",
    "src/App.tsx",           
    "src/BuggyComponent.tsx",
    "src/index.js"           
  ]
}